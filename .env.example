DATABASE_URL=postgresql://postgres:password@localhost:5432/artem
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUSTED_PROXY_HOPS=1
ADMIN_EMAIL=admin@example.com
# Если в пароле есть $ — Next.js развернёт это как переменную и обрежет пароль.
# Не используй $ в ADMIN_PASSWORD (или храни пароль без долларов).
ADMIN_PASSWORD=replace-with-strong-password-14plus

# local | s3 — для лендинга достаточно local (файлы в public/media/uploads)
MEDIA_DRIVER=local

# Только для MEDIA_DRIVER=s3
# S3_ENDPOINT=https://s3.timeweb.cloud
# S3_REGION=ru-1
# S3_BUCKET=artem-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# false / unset — noindex + robots Disallow:/ (временный домен). true — открыть для поиска.
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Optional: Telegram notifications for new leads
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# На Timeweb DNS api.telegram.org часто отдаёт мёртвый IP — форсим живой DC:
# TELEGRAM_API_IP=149.154.167.220
# TELEGRAM_API_IPS=149.154.167.220,149.154.167.50
# Или Cloudflare Worker / внешний proxy:
# TELEGRAM_API_BASE=https://your-worker.workers.dev
