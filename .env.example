DATABASE_URL=postgresql://postgres:password@localhost:5432/artem
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUSTED_PROXY_HOPS=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password-14plus
# Если в пароле есть $ — экранируй: pass\$word (Next.js иначе обрежет)

# local | s3 — для лендинга достаточно local (файлы в public/media/uploads)
MEDIA_DRIVER=local

# Только для MEDIA_DRIVER=s3
# S3_ENDPOINT=https://s3.timeweb.cloud
# S3_REGION=ru-1
# S3_BUCKET=artem-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
