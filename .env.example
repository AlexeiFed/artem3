DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artem
SESSION_SECRET=replace-with-at-least-32-random-characters
# Number of trusted Timeweb reverse-proxy hops appended to X-Forwarded-For (1..5).
TRUSTED_PROXY_HOPS=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-14-characters

S3_ENDPOINT=https://s3.example.com
S3_REGION=ru-central1
S3_BUCKET=artem-media
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_YANDEX_METRIKA_ID=
